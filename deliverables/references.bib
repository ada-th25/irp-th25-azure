@article{qiAdvancingImageSuperresolution2026,
  title = {Advancing Image Super-Resolution Techniques in Remote Sensing: {{A}} Comprehensive Survey},
  shorttitle = {Advancing Image Super-Resolution Techniques in Remote Sensing},
  author = {Qi, Yunliang and Lou, Meng and Liu, Yimin and Li, Lu and Yang, Zhen and Nie, Wen},
