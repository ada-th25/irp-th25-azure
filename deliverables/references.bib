  file = {/Users/th25/Zotero/storage/7HHS7S7Y/Qi et al. - 2026 - Advancing image super-resolution techniques in remote sensing A comprehensive survey.pdf;/Users/th25/Zotero/storage/VYN7WT23/S0924271625004125.html}
}

@article{sahariaImageSuperResolutionIterative2023,
  title = {Image {{Super-Resolution}} via {{Iterative Refinement}}},
  author = {Saharia, Chitwan and Ho, Jonathan and Chan, William and Salimans, Tim and Fleet, David J. and Norouzi, Mohammad},
  date = {2023-04},
  journaltitle = {IEEE Transactions on Pattern Analysis and Machine Intelligence},
  volume = {45},
