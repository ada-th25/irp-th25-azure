@inproceedings{zhangImageSegmentationBased2008,
  title = {Image {{Segmentation Based}} on {{2D Otsu Method}} with {{Histogram Analysis}}},
  booktitle = {2008 {{International Conference}} on {{Computer Science}} and {{Software Engineering}}},
  author = {Zhang, Jun and Hu, Jinglu},
  date = {2008-12},
  volume = {6},
