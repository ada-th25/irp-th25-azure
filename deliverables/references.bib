@article{sunCredDSRCrossResolution2025,
  title = {{{CredDSR}}: {{A Cross Resolution Distance Aware DEM Super-Resolution Method With Terrain Difficulty Perception Loss}}},
  shorttitle = {{{CredDSR}}},
  author = {Sun, Chengzhe and Chen, Luo and Xiong, Wei and Chen, Hao},
  date = {2025},
  journaltitle = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
  shortjournal = {IEEE J. Sel. Top. Appl. Earth Obs. Remote Sens.},
  volume = {18},
  pages = {28830--28840},
  issn = {2151-1535},
  doi = {10.1109/JSTARS.2025.3624584},
  url = {https://ieeexplore.ieee.org/abstract/document/11215900},
  urldate = {2026-04-26},
  abstract = {Digital elevation model (DEM) is the foundational data for geographical analysis and applications, but its low-resolution limits its applications. Deep learning-based DEM super-resolution models offer powerful tools for deriving high-resolution DEMs from low-resolution ones, while the learning of terrain features and geographical knowledge by models is crucial for achieving high-precision DEM super-resolution. However, current methods overlook two critical issues: first, the corresponding cells between low and high resolution DEMs exhibit significant spatial correlation, but current methods lack the utilization of this prior information on cross resolution spatial distance. Second, existing methods neglect targeted learning for challenging terrains during the optimization process, leading to insufficient reconstruction accuracy in some areas with frequent topographic relief. To address these two issues, this article proposes a cross resolution distance aware DEM super-resolution method with terrain difficulty perception loss, called CredDSR. First, we propose a cross-resolution attention mechanism. It calculates cross-resolution attention based on the distances between cells on low-resolution and high-resolution DEMs, which is then used to guide the generation of high-resolution DEM features. Then, during the learning process, we design a terrain difficulty perception loss to dynamically amplify the learning weights of high-error regions, enabling targeted learning of challenging terrains. Extensive experiments demonstrate that our model excels in DEM super-resolution accuracy while efficiently saving computational resources and parameters, with CredDSR achieving a 7.89\% elevation RMSE reduction on the Nevada dataset and 3.46\% on the ALOS-Heishui dataset compared to state-of-the-art models.},
  keywords = {Accuracy,Cross resolution distance aware,Deep learning,deep learning (DL),digital elevation model (DEM) super resolution (SR),Feature extraction,Image reconstruction,Interpolation,Neural networks,Remote sensing,Spatial resolution,super-resolution,Superresolution,terrain difficulty perception,Transformers},
  file = {/Users/th25/Zotero/storage/QCL4HAKI/Sun et al. - 2025 - CredDSR A Cross Resolution Distance Aware DEM Super-Resolution Method With Terrain Difficulty Perce.pdf}
}

