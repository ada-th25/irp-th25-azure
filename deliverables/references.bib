@article{wangInformationGuidedDiffusionModel2025,
  title = {Information-{{Guided Diffusion Model}} for {{Downscaling Land Surface Temperature}} from {{SDGSAT-1 Remote Sensing Images}}},
  author = {Wang, Jianxin and Fu, Zhitao and Tang, Bohui and Xu, Jianhui},
  date = {2025-01},
  journaltitle = {Remote Sensing},
  volume = {17},
